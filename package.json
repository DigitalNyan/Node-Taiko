{
  "name": "node-taiko",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --config frontend/vite.config.js --host 0.0.0.0",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node server/index.js",
    "import:mongo-json": "node scripts/import-mongo-json.js"
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "append-field": "^1.0.0",
    "array-flatten": "^1.1.1",
    "bagpipe": "^0.3.5",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "busboy": "^1.6.0",
    "bytes": "^3.1.2",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "concurrently": "^9.1.2",
    "cookie": "^0.7.2",
    "cookie-signature": "^1.0.6",
    "debug": "^2.6.9",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "fs-extra": "^11.2.0",
    "kruptein": "^0.1.2",
    "mime": "^1.6.0",
    "multer": "^2.5.0",
    "rxjs": "^7.8.1",
    "session-file-store": "^1.5.0",
    "ws": "^8.18.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "rollup": "^4.34.0",
    "vite": "^6.4.6",
    "vue": "^3.5.13"
